<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- target28 uses legacy normal Bluetooth permissions, including on newer OS compatibility paths.
         Do not cap these at API30 while target remains28. Manual foreground BLE scan uses location permission below. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- ==================== 开机自启 ==================== -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ==================== WiFi 控制 ==================== -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Foreground, user-initiated Wi-Fi Direct requires FINE_LOCATION for target28, including new OS compatibility paths. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />
    <!--
      关键后路权限：签名级，普通安装拿不到，但可以通过
        adb shell pm grant com.carassistant android.permission.WRITE_SECURE_SETTINGS
      或 root 手动授予。有了它，无 root 也能通过写 Settings.Global.WIFI_ON 开 WiFi。
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- ==================== 后台启动 Activity ==================== -->
    <!-- 部分 ROM 要求持有悬浮窗权限才放行后台启动 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />

    <!-- ==================== 前台服务与电源 ==================== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ==================== 查询已安装应用 ==================== -->
    <!-- Android 11+ 需要它才能扫描到车机上预装的亿连等应用 -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- ==================== 下载与安装 APK ==================== -->
    <!--
      手机推送的局域网 HTTP 服务（ServerSocket）与直链下载都需要它；
      不涉及任何数据上报。推送服务只监听本机网卡、只服务局域网客户端。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      调起系统安装器（安装链 I3）需要声明它。注意这是「按应用」的开关：
      Android 8+ 上还需要用户在「安装未知应用」页面给本应用单独打开，
      见 Permissions.canInstallPackages()；没有授权时我们会引导用户去开，而不是假装成功。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      扫描本机 / U 盘上的 .apk 文件需要读存储。
      本应用 targetSdk=28 走旧版存储模型，Android 10~12 上该权限仍然有效；
      Android 13+ 已废弃该权限，但这里保留声明（部分 ROM 仍按旧版模型授予）。
      拿不到时页面如实提示，并按当前可见范围继续扫描，不会崩溃。
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:name=".CarAssistantApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarAssistant"
        tools:targetApi="31">

        <!-- ==================== 主界面 ==================== -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.CarAssistant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ==================== 开机广播触发器 ==================== -->
        <receiver
            android:name=".receiver.TriggerReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <!-- 熄火不断电的车机（快速启动）走这两个 -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <!-- 上电 / 接车载底座 -->
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.DOCK_EVENT" />
                <!-- 亮屏（可选触发源） -->
                <action android:name="android.intent.action.SCREEN_ON" />
                <!-- 覆盖安装后自激活 -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ==================== 执行前台服务 ==================== -->
        <service
            android:name=".service.AssistantService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="车机开机自动执行 WiFi 开启与应用启动" />
        </service>

        <!-- ==================== 无障碍服务（兜底能力） ==================== -->
        <service
            android:name=".service.AssistAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ==================== APK 文件共享（安装链 I3 用） ==================== -->
        <!--
          系统安装器只接受 content:// URI（Android 7.0 起不再允许 file:// 直接传递，
          会抛 FileUriExposedException），所以下载目录和 U 盘的 APK 都通过
          FileProvider 暴露给安装器，且授权是「单次 URI 级」的，不对外开放。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
