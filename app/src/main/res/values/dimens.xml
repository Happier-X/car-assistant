<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      车机屏幕普遍是 1280x720 / 1024x600，DPI 偏高，
      而且驾驶场景下需要更大的点击热区。所以这里给的尺寸都比手机端大一圈。
    -->
    <dimen name="screen_padding">20dp</dimen>
    <dimen name="card_corner">16dp</dimen>
    <dimen name="card_spacing">12dp</dimen>
    <dimen name="min_touch_target">56dp</dimen>
</resources>